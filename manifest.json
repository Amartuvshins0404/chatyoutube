{
  "manifest_version": 3,
  "name": "ChatYouTube",
  "version": "1.1.1",
  "description": "Transcript, AI summary, highlights, chat and web search for any YouTube video. Uses your ChatGPT API key. Nothing leaves your browser except OpenAI and your search provider.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "ChatYouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.openai.com/*",
    "https://lite.duckduckgo.com/*",
    "https://html.duckduckgo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
